# Copy this file to ".env" and fill in your TypeSafe (Jev) API key.
# Get a key at: https://console.typesafe.ai/keys

TYPESAFE_API_KEY=your_key_here

# --- Optional tuning (defaults shown) ---
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_S=15

# Decision thresholds
# RISK_THRESHOLD=0.8
# LANE_CHANGE_CONFIDENCE_THRESHOLD=0.6
# LONGITUDINAL_CONFIDENCE_THRESHOLD=0.5

# Environment
# DT_S=1.0
# ACCEL_DELTA_KMH=5
# BRAKE_DELTA_KMH=10
# MIN_FRONT_DISTANCE_M=5
# CRITICAL_FRONT_DISTANCE_M=8
# NUM_LANES=2

# Simulation
# DEFAULT_CONTINUOUS_STEPS=30
# DEFAULT_SINGLE_STEPS=1
# LOOP_SLEEP_S=1.0
# LOG_DIR=logs
